# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp provider: evolution (default) | meta
WHATSAPP_PROVIDER=evolution
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=main
EVOLUTION_WEBHOOK_TOKEN=

# Meta (only if WHATSAPP_PROVIDER=meta)
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o

# Redis (BullMQ) - OPTIONAL for local dev. Leave empty to process messages inline (no Redis needed).
REDIS_URL=
